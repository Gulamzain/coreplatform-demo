# Dependency directories
**/node_modules/
**/.pnp
.pnp.*

# Next.js build output
**/.next/
**/out/

# Production build folders
**/build/
**/dist/

# Testing
**/coverage/

# Environment files (Keep your secrets private)
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local

# Debug logs
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# Vercel metadata
**/.vercel

# System files
**/.DS_Store
**/Thumbs.db

# TypeScript cache
**/*.tsbuildinfo
**/next-env.d.ts